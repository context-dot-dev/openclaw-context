{
  "name": "@openclaw/context-plugin",
  "version": "2026.8.1",
  "description": "Context.dev web search, scraping, extraction, parsing, brand intelligence, monitors, and batches for OpenClaw.",
  "repository": {
    "type": "git",
    "url": "https://github.com/openclaw/openclaw"
  },
  "type": "module",
  "dependencies": {
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@openclaw/plugin-sdk": "workspace:*"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@openclaw/context-plugin",
      "npmSpec": "@openclaw/context-plugin",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.8.1",
      "allowInvalidConfigRecovery": true
    },
    "compat": {
      "pluginApi": ">=2026.8.1"
    },
    "build": {
      "openclawVersion": "2026.8.1",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
